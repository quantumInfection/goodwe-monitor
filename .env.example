# --- GoodWe inverter monitor configuration ---
# Copy to .env and edit:  cp .env.example .env

# --- Data source -------------------------------------------------------
# "sems"  = GoodWe cloud portal (works with DTLS-only dongles, ~5 min latency)
# "local" = poll the inverter directly on the LAN (needs plain UDP or Modbus TCP)
DATA_SOURCE=local

# SEMS portal login (same credentials as the SEMS/SolarGo web portal).
SEMS_ACCOUNT=
SEMS_PASSWORD=
# Leave blank to auto-detect; otherwise the plant uuid from the portal URL.
SEMS_STATION_ID=
# Regional host. Login usually redirects automatically if this is wrong.
SEMS_BASE_URL=https://www.semsportal.com
# Only used as a last resort. gridStatus was observed NOT to track direction
# (it read 1 while both importing and exporting), so direction now comes from
# the signed pmeter, or from the pv/load/battery energy balance.
SEMS_IMPORT_STATUS=1

# Fallback inverter IP, used only if UDP auto-discovery fails.
INVERTER_IP=192.168.1.100

# Webhook fired when grid draw exceeds the threshold.
# --- Quiet periods -----------------------------------------------------
# Only alert between these hours (24h, local time). Blank = always.
# Overnight grid draw is unavoidable with no sun, so alerting on it is noise.
# Windows may wrap midnight, e.g. 22:00-06:00.
ACTIVE_HOURS=05:00-19:15

# Restrict to certain days too, e.g. mon-fri or sat,sun. Blank = every day.
ACTIVE_DAYS=

# Also mute while solar output is below this many watts, i.e. the sun is not
# really up yet. 0 disables. Self-adjusting alternative to ACTIVE_HOURS.
MIN_PV_WATTS=0

# --- Alerts ------------------------------------------------------------
# Show a native macOS notification when the threshold is crossed.
NOTIFY_MACOS=true
# Notification sound name (Ping, Glass, Hero, Submarine...). Blank = silent.
NOTIFY_SOUND=Ping

# Optional webhook, in addition to the notification.
# Leave blank to print alerts to the terminal instead of POSTing.
WEBHOOK_URL=

# Fire the webhook when the house is pulling more than this many watts
# FROM the grid. Solar export never triggers it.
GRID_DRAW_THRESHOLD_WATTS=100

# Seconds between polls of the inverter.
POLL_INTERVAL=10

# Seconds to pause after firing the webhook, so the endpoint is not spammed.
DEBOUNCE_TIME=300


# --- Optional: only change these if the defaults misbehave ---

# Runtime-data sensor holding grid power. Leave blank to auto-detect from
# the connected inverter (tries meter_p, meter_active_power_total,
# active_power, meter_active_power, pgrid in that order).
GRID_POWER_SENSOR=

# GoodWe reports grid power as EXPORT-positive, so importing from the grid is
# a negative number. "true" flips the sign so grid draw counts as positive,
# which is what the threshold expects. Set to "false" only if your inverter
# already reports import as positive.
INVERT_GRID_SIGN=true

# UDP port, per-request timeout (s), and retries for the inverter connection.
INVERTER_PORT=8899
INVERTER_TIMEOUT=1
INVERTER_RETRIES=3

# Seconds to wait for the webhook POST before giving up.
WEBHOOK_TIMEOUT=10

# Consecutive read failures tolerated before reconnecting / re-discovering.
MAX_READ_FAILURES=5

# Set to DEBUG for verbose output.
LOG_LEVEL=INFO

# Log file for background/agent runs. Blank = log to the terminal only.
# The launchd agent sets this itself; you normally leave it blank here.
LOG_FILE=
LOG_MAX_BYTES=1000000
LOG_BACKUPS=3
